# Copiar a .env.local (local) o cargar en Vercel > Settings > Environment Variables.

# Obligatoria. Clave para firmar la sesión (JWT HS256). En producción: openssl rand -hex 32
AUTH_SECRET=

# TSI-206 — URL del bot del backend. Vacío = el envío se simula (destino MOCK).
BOT_URL=

# TSI-102 — PostgreSQL (Prisma). Vacío = se usa el mock SQLite de BD/ (no válido en Vercel).
# Ej.: postgresql://user:pass@host:5432/salud_irrecuperable?schema=public
DATABASE_URL=
