# Copiar a .env.local

# Backend real (Express, repo backend-plataforma-salud-irrecuperable).
# El front proxea /api/* hacia acá y verifica la sesión con /api/v1/auth/me.
# La sesión es una cookie opaca (sir_session, HttpOnly) + sir_csrf — NO un JWT,
# así que no hay ninguna clave que configurar en el front.
BACKEND_URL=http://localhost:3000
