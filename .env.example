# Copiar a .env.local (local) o cargar en Vercel > Settings > Environment Variables.

# Obligatoria. Clave para verificar el JWT de sesión (HS256). Misma que firma el backend.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Obligatoria en integración. URL base del backend (el front proxea /api/* hacia acá).
# Ej.: https://api.salud-irrecuperable.example.com
BACKEND_URL=
